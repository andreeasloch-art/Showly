# ---------------------------------------------------------------------------
# Showly: Zugangsdaten
# Diese Datei ist die Vorlage. Kopiere sie zu .env und trag deine Werte ein.
# .env gehört niemals in die Versionsverwaltung.
# ---------------------------------------------------------------------------

# Supabase: Adresse und öffentlicher Schlüssel. Beide dürfen im Browser stehen.
# Zu finden unter Project Settings, API.
VITE_SUPABASE_URL=https://deinprojekt.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Dienstschlüssel. Umgeht alle Zugriffsregeln der Datenbank.
# Nur auf dem Server, niemals in den Browser, niemals in ein Repository.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe: Zahlungen und Ausweisprüfung laufen über dasselbe Konto.
STRIPE_SANDBOX_API_KEY=sk_test_...
STRIPE_LIVE_API_KEY=sk_live_...
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_...

# Bestätigungsmails (optional). Ohne Schlüssel wird einfach nichts verschickt.
RESEND_API_KEY=re_...
SHOWLY_MAIL_FROM=Showly <buchung@deine-domain.de>
